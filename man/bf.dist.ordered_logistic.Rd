\deqn{\Pr(Y = k \mid \eta, c) = \begin{cases} 1 - \mathrm{logit}^{-1}(\eta - c_1), & k = 1, [6pt] \mathrm{logit}^{-1}(\eta - c_{k-1}) - \mathrm{logit}^{-1}(\eta - c_{k}), & 1 < k < K, [6pt] \mathrm{logit}^{-1}(\eta - c_{K-1}), & k = K. \end{cases}}

